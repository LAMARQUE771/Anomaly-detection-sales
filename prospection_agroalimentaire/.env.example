# Copier ce fichier en ".env" et renseigner vos clés (ne jamais committer .env)

# Clé d'intégration Sirene/INSEE (portail api.insee.fr)
SIRENE_API_KEY=

# Jeton API Pappers (https://dashboard.pappers.fr)
PAPPERS_API_KEY=

# Optionnel : override des valeurs par défaut du script
# PAPPERS_MONTHLY_QUOTA=250
# PAPPERS_DELAY_SECONDS=1.5
